FROM python:3.12-slim

# Install system dependencies for OpenCV, FAISS compilation, and screen capturing tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies first for better caching
COPY backend/requirements.txt ./backend/
RUN pip install --no-cache-dir -r backend/requirements.txt

# Copy source code and datasets placeholder
COPY backend/ ./backend/
COPY scripts/ ./scripts/

# Make sure folders exist
RUN mkdir -p datasets/weights datasets/minerl datasets/memory datasets/voice/cache

# Port configuration
EXPOSE 8000

ENV PYTHONPATH=/app

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
