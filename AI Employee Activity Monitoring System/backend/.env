# VisionTrack AI - System Configurations

# FastAPI Server Port
PORT=8000
HOST=0.0.0.0

# Firebase Firestore Private key path
# Place your Firebase Admin private key JSON inside "backend/firebase_key.json"
# and specify its path here. If omitted, system defaults to Demo Local Mode.
FIREBASE_KEY_PATH=backend/firebase_key.json

# Optional: Directly paste service account JSON structure
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": ...}
